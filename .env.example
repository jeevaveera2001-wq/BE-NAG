# ==========================================
# NAGULAN UNISEX SALON - BACKEND ENVIRONMENT
# ==========================================

# Server Port
PORT=5000

# MongoDB Database Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/nagulan_salon
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nagulan_salon?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nagulan_salon?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=7d

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production)
NODE_ENV=development
